# Copy to .env before running. Never commit real values.
PORT=3000
NODE_ENV=development
# Deploy version injected by CI; locally set to a dev placeholder (no shell expansion in .env)
DEPLOY_VERSION=dev-local
# Redis URL (optional cache for CI metadata)
REDIS_URL=redis://127.0.0.1:6379
# Postgres URL (optional demo store)
DATABASE_URL=postgresql://formforge:formforge@127.0.0.1:5432/formforge
# Trust proxy: set ONLY when behind your own infrastructure proxy
TRUST_PROXY=loopback