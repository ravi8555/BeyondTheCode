# Copy to .env before running. Never commit real values.
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://formforge_dev:formforge_dev@127.0.0.1:5432/formforge
TRUST_PROXY=loopback
# Staleness budget (product decisions, not performance vibes):
FORM_FRESH_TTL_MS=60000
FORM_STALE_WINDOW_MS=540000
FORM_NEGATIVE_TTL_MS=30000
CACHE_TTL_JITTER_RATIO=0.1
