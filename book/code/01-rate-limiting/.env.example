# Copy to .env before running. Never commit real values.
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Express 'trust proxy': set ONLY when behind your own proxy (hop count, or
# 'loopback' / 'uniquelocal'). See chapter 01, section 7 (spoofed XFF).
TRUST_PROXY=loopback
SUBMIT_LIMIT=10
SUBMIT_WINDOW_MS=60000
